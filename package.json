{
  "name": "weathergpt",
  "version": "1.0.0",
  "description": "WeatherGPT — AI Weather Alert & Assistance Agent",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node --watch server/index.js",
    "client": "npm run dev --prefix client -- --host",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "test": "vitest run"
  },
  "keywords": [
    "weather",
    "ai",
    "weathergpt",
    "alerts",
    "hackathon"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.0.7"
  }
}
